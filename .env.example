# ---- Backend API ----
API_PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-48-byte-secret-before-running
# First administrator. Fill all three to create it on first start (password 14+ characters). No default credentials exist.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Database ----
# Leave empty to use the local JSON file (development only).
# MySQL / MariaDB for staging and production, then run: npm run db:migrate
# DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# Local JSON store directory (only used when DATABASE_URL is empty)
# APEX_DATA_DIR=./data

# ---- Email (Resend). Placeholders: email stays disabled until real values are set ----
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=


# ---- Map tiles (optional) ----
# Default is OpenStreetMap's free public tiles (no key). For a busy production site use a provider with a
# free tier or your own tile server and set the URL here (a key can be part of the URL).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# ---- Hosting ----
NODE_ENV=production
# Number of proxies in front of Node (1 for nginx/Caddy/most hosts) so rate limits see real visitor IPs
TRUST_PROXY_HOPS=1
